  "flags": [
    {
      "note": "16",
      "title": "Section 232: steel, aluminium and copper (and derivative articles)",
      "how": "Applies to the full value when the metal is at least 15% of the article's weight (any weight for chapters 72, 73, 74 and 76). Rates run from 10% to 50% depending on origin and metal source. Where it applies, the 2026 note-52 duty does not."
    },
    {
      "note": "33",
      "title": "Section 232: passenger vehicles, light trucks and their parts",
      "how": "25% on listed vehicles and parts, with country deals. Where it applies, the 2026 note-52 duty does not."
    },
    {
      "note": "37",
      "title": "Section 232: timber, lumber, upholstered furniture, kitchen cabinets and vanities",
      "how": "10% on softwood lumber, 25% on upholstered wooden furniture and on kitchen cabinets and vanities, with country caps. Where it applies, the 2026 note-52 duty does not."
    },
    {
      "note": "38",
      "title": "Section 232: medium- and heavy-duty vehicles, buses and their parts",
      "how": "10% to 25%. Where it applies, the 2026 note-52 duty does not."
    },
    {
      "note": "39",
      "title": "Section 232: semiconductors",
      "how": "25% on semiconductor articles, with end-use exemptions. Where it applies, the 2026 note-52 duty does not."
    },
    {
      "note": "40",
      "title": "Section 232: pharmaceuticals",
      "how": "Up to 100% on patented pharmaceuticals, with country caps and exemptions; generics excluded. Where it applies, the 2026 note-52 duty does not."
    },
    {
      "note": "41",
      "title": "Section 201 safeguard: quartz surface products",
      "how": "25% within the quota, 50% above it."
    },
    {
      "note": "43",
      "title": "Section 232: unmanned aircraft (drones), their parts and components",
      "how": "Up to 100% on drones and listed parts, with country caps. This one does NOT replace the 2026 note-52 duty."
    }
  ],
